#Calculate the variance of the availability estimator for any fixed "n", Sadek and Limnios, Theorem 5


nstate      <- nrow(trans_prob_theor)
init_avail  <- c(rep(initial[1],nstate),rep(initial[2],nstate),rep(initial[3],nstate))   #new initial vector from the initial vector initial

start.time <- Sys.time()

sigma_availability <- vector("numeric",length=pow_max)

for (i in 1:pow_max){
    Sigma_f               <- Sigma(pi_bru,trans_prob_theor,i)                     #for any power, calculate the matrix Sigma
    sigma_availability[i] <- sigma_avail(pi_bru,Sigma_f,i,2,init_avail)           #modify the matrix Sigma, to obtain the variance of the availability
    rm(Sigma_f)
}

end.time <- Sys.time()

time.taken <- round(end.time-start.time,2)

s <- sigma_availability


