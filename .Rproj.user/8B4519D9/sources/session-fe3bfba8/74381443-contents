cov_avail <- function(stat,mat_sigma,n,nup){
#
#stat: stationary distribution
#mat_sigma:  matrix Sigma, Theorem 4, Sadek and Limnios
#n: power
#init: initial law
#
nstate <- length(stat)
ncl    <- nstate^2
nrw    <- nstate^2
#
r      <- nup      #number of up states
#
for (i in 1:nstate){
#
  k <- (i-1)*nstate+r+1
  mat_sigma[k,] <- 0
  mat_sigma[,k] <- 0
#
}
#
return(mat_sigma)
#
}


