# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Running Script
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Create a Markov Chain
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Choose the transition probability matrix and the initial law of the MC
a <- c(0.5, 0.5, 0)
P <- matrix(c(0.3, 0.7, 0,
              0.6, 0.1, 0.3,
              0.5, 0,   0.5), nrow = 3, ncol = 3, byrow = TRUE)

# Create a Markov Chain
x <- MarkovChain(a = a, P = P)

# Find Stationary distribution
pi_vec <- stationary(x)

# Simulate a single trajectory of length m
m <- 1e4
traj <- sim(m, x)

# Estimate the transition probability matrix
y <- estim(traj)

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Calculate Matrices Gamma, Sigma
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Gamma
# Avar of p_hat (vector)
Gamma <- gamma_mat(x) # Sadek and Limnios, Proposition 1

# Calculate matrix Sigma
n <- 2 # choose the power
Sigmaf1 <- sigma_mat(x, n) # Sadek and Limnios, Theorem 4

####################################

# Paper with George and Samis
# Example for nstate=3 and k=2 (power)


# Calculate the asymptotic covariance for P^2 (k=2), example paper
# Section 3.4: asymptotic covariance computation for any number of Markov states
# nstate = 3

library(fastmatrix)
term1 <- kronecker.prod(P,diag(3))+kronecker.prod(diag(3),t(P))
term2 <- Gamma
term3 <- kronecker.prod(t(P),diag(3))+kronecker.prod(diag(3),P)
cov_final <- term1 %*% term2 %*% term3 #covariance

isSymmetric.matrix(cov_final) #verify the symmetry

cov_final == Sigmaf1 # compare covariance of Theorem 4 with covariance with the new article

# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Mean Time to Failure
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Choose the up states
up <- c(1, 2)

# Calculate the theoretical MTTF
mttf_true <- mttf(x, up)

# Estimate the MTTF
mttf_estim <- mttf(y, up)

# Calculate the asymptotic variance
mttf_var <- mttf_var(x, up)

# Monte Carlo simulations
set.seed(1)
k <- 1e4
mttf_estim <- estim_parallel(k = k, m = m, x = x, fun = markov::mttf,
                             up = up, a = a)
mttf_norm <- sqrt(m) * (mttf_estim - rep(mttf_true, k))
var(mttf_norm)

# Plot
curve({dnorm(x, mean = 0, sd = sqrt(mttf_var))}, ylab = "Density",
      xlim = c(min(mttf_norm), max(mttf_norm)), col = "blue", lwd = 3)
abline(v = 0, col = "blue", lty = 2, lwd = 3)
hist(mttf_norm,
     col = rgb(1, 0, 0, 0.1),
     freq = FALSE,
     xlab = expression(widehat(MTTF)(m)),
     nclass = 50,
     las = 1,
     add = TRUE)

