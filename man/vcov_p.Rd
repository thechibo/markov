  \xrightarrow[n\to\infty]{d}
  \mathbf W_{\mathbf p},
  \qquad
  \mathbf W_{\mathbf p}
  \sim
  \mathcal N_{s^2}
  \left(
    \mathbf 0_{s^2},
    \Sigma_{\mathbf p}
  \right).
}

